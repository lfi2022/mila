  event       String   @db.VarChar(64)
  subjectHash String   @map("subject_hash") @db.Char(64)
  sessionHash String   @map("session_hash") @db.Char(64)
  path        String?  @db.VarChar(255)
  properties  Json?
  occurredAt  DateTime @map("occurred_at") @db.DateTime(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([sessionHash, event, occurredAt])
  @@index([event, occurredAt])
  @@index([subjectHash, occurredAt])
  @@map("product_analytics_events")
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @map("actor_id") @db.Char(36)
  action     String   @db.VarChar(120)
  targetType String   @map("target_type") @db.VarChar(64)
  targetId   String?  @map("target_id") @db.Char(36)
  reason     String?  @db.VarChar(500)
  before     Json?
  after      Json?
  metadata   Json?
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_logs")
}

model FeatureFlag {
  key         String   @id @db.VarChar(120)
  enabled     Boolean  @default(false)
  description String?  @db.VarChar(500)
  config      Json?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("feature_flags")
}

model ListEntitlement {
  id        String    @id @default(uuid()) @db.Char(36)
  listId    String    @unique @map("list_id") @db.Char(36)
  paymentId String?   @unique @map("payment_id") @db.Char(36)
  plan      String    @default("FREE") @db.VarChar(64)
  startsAt  DateTime  @default(now()) @map("starts_at") @db.DateTime(3)
  expiresAt DateTime? @map("expires_at") @db.DateTime(3)
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  list      GiftList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("list_entitlements")
}

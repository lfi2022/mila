generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AppRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum ListRole {
  OWNER
  CO_OWNER
  EDITOR
}

enum ListType {
  BIRTH
  BIRTHDAY
  CHRISTENING
  CHRISTMAS
  WEDDING
  OTHER
}

enum ListVisibility {
  PUBLIC
  UNLISTED
  PROTECTED
}

enum ListStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SUSPENDED
  DELETED
}

enum GiftKind {
  LINK
  PRODUCT
  SERVICE
  EXPERIENCE
  FREE_GIFT
  CONTRIBUTION
}

enum GiftStatus {
  AVAILABLE
  RESERVED
  FUNDED
  READY_TO_ORDER
  ORDERED
  SHIPPED
  RECEIVED
  CANCELLED
  UNAVAILABLE
}

enum SecondHandPolicy {
  NEW_ONLY
  SECOND_HAND_ALLOWED
  SECOND_HAND_PREFERRED
}

enum OfferPreference {
  FIXED_MERCHANT
  SUGGEST_BEST
  AUTO_BEST
}

enum ReservationStatus {
  RESERVED
  PURCHASED
  CANCELLED
  EXPIRED
}

enum ContributionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  CHARGEDBACK
}

enum ProductMediaSourceType {
  OFFICIAL_API
  AFFILIATE_FEED
  LICENSED
  USER_UPLOADED
  REMOTE_VERIFIED
  REMOTE_UNVERIFIED
  GENERIC_LIBRARY
  GENERATED
  BLOCKED
}

enum ProductMediaUsageStatus {
  AUTHORIZED
  AUTHORIZED_REMOTE_ONLY
  AUTHORIZED_CACHE
  USER_DECLARED
  REVIEW_REQUIRED
  BLOCKED
}

enum GenericImageCategory {
  STROLLER
  PLUSH_RABBIT
  BABY_BOUNCER
  BABY_CRIB
  CLOTHING
  FEEDING
  BATH
  TOY
  OTHER
}

enum ImageStatus {
  PENDING
  ACTIVE
  EXPIRED
  REMOVED
  BLOCKED
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum RewardTransactionType {
  AFFILIATE_COMMISSION
  REFERRAL
  PREMIUM_PURCHASE
  PARTNER_BONUS
  PROMOTIONAL_BONUS
  REDEMPTION
  ADJUSTMENT
}

enum LedgerStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  REVERSED
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
  CANCELLED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  CANCELLED
}

enum PaymentProvider {
  MOLLIE
  BANK_TRANSFER
  MANUAL
}

enum PaymentStatus {
  CREATED
  OPEN
  PENDING
  AUTHORIZED
  PAID
  FAILED
  EXPIRED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
  CHARGEDBACK
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TransferStatus {
  WAITING_TRANSFER
  TRANSFER_RECEIVED
  MATCHED
  MANUAL_REVIEW
  REFUNDED
}

enum FinancialEntryType {
  CONTRIBUTION_IN
  CONTRIBUTION_REFUND
  PARENT_PAYOUT
  ORDER_PAYMENT
  MOLLIE_FEE
  PLATFORM_FEE
  AFFILIATE_REVENUE
  REWARD_CREDIT
  REWARD_REDEMPTION
  PREMIUM_REVENUE
  ADJUSTMENT
}

enum OrderMode {
  MANUAL_PARENT
  ASSISTED_PARENT
  AUTOMATIC_PLATFORM
}

enum OrderGroupStatus {
  DRAFT
  READY
  WAITING_PARENT
  SUBMITTED
  PARTIALLY_ORDERED
  ORDERED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum SecondHandCondition {
  LIKE_NEW
  VERY_GOOD
  GOOD
  FAIR
}

enum SecondHandOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id                       String                    @id @default(uuid()) @db.Char(36)
  email                    String                    @unique @db.VarChar(255)
  passwordHash             String                    @map("password_hash") @db.VarChar(255)
  displayName              String?                   @map("display_name") @db.VarChar(120)
  avatarKey                String?                   @map("avatar_key") @db.VarChar(512)
  emailVerifiedAt          DateTime?                 @map("email_verified_at") @db.DateTime(3)
  onboardingCompleted      Boolean                   @default(false) @map("onboarding_completed")
  suspendedAt              DateTime?                 @map("suspended_at") @db.DateTime(3)
  deletedAt                DateTime?                 @map("deleted_at") @db.DateTime(3)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  roles                    UserRole[]
  sessions                 Session[]
  verificationTokens       EmailVerificationToken[]
  resetTokens              PasswordResetToken[]
  ownedLists               GiftList[]                @relation("ListOwner")
  memberships              ListMember[]
  sentInvitations          ListInvitation[]          @relation("InvitationSender")
  acceptedInvitations      ListInvitation[]          @relation("InvitationAccepter")
  reservations             Reservation[]
  paymentAccounts          PaymentAccount[]
  requestedPayouts         Payout[]                  @relation("PayoutRequester")
  orderStatusChanges       OrderGroupStatusHistory[]
  requestedRedemptions     RewardRedemption[]
  sentReferrals            Referral[]                @relation("Referrer")
  receivedReferral         Referral?                 @relation("Referred")
  referralCode             ReferralCode?
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  messages                 Message[]
  uploadedMedia            MediaAsset[]
  thankYous                ThankYou[]
  approvedMessages         Message[]                 @relation("MessageApprover")
  reviewedSecondHandOffers SecondHandOffer[]         @relation("SecondHandReviewer")
  approvedMemoryItems      MemoryBookItem[]          @relation("MemoryItemApprover")
  partnerAttributions      PartnerAttribution[]
  listLifecycleEvents      ListLifecycleEvent[]
  privacyConsents          PrivacyConsent[]
  privacyRequests          DataSubjectRequest[]      @relation("PrivacyRequester")
  assignedPrivacyRequests  DataSubjectRequest[]      @relation("PrivacyAssignee")
  riskReviews              RiskReview[]              @relation("RiskSubject")
  reviewedRisks            RiskReview[]              @relation("RiskReviewer")
  reports                  Report[]                  @relation("Reporter")
  auditLogs                AdminAuditLog[]           @relation("AuditActor")

  @@index([createdAt])
  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  ipHash     String?   @map("ip_hash") @db.Char(64)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model GiftList {
  id                       String                 @id @default(uuid()) @db.Char(36)
  ownerId                  String                 @map("owner_id") @db.Char(36)
  slug                     String                 @unique @db.VarChar(120)
  title                    String                 @db.VarChar(180)
  description              String?                @db.Text
  welcomeMessage           String?                @map("welcome_message") @db.Text
  childName                String?                @map("child_name") @db.VarChar(120)
  coverMediaKey            String?                @map("cover_media_key") @db.VarChar(512)
  dueDate                  DateTime?              @map("due_date") @db.Date
  type                     ListType               @default(BIRTH)
  visibility               ListVisibility         @default(UNLISTED)
  status                   ListStatus             @default(DRAFT)
  accessCodeHash           String?                @map("access_code_hash") @db.VarChar(255)
  surpriseMode             Boolean                @default(false) @map("surprise_mode")
  hideReservedGifts        Boolean                @default(false) @map("hide_reserved_gifts")
  showReservationNames     Boolean                @default(false) @map("show_reservation_names")
  allowIndexing            Boolean                @default(false) @map("allow_indexing")
  showProgress             Boolean                @default(true) @map("show_progress")
  theme                    String                 @default("default") @db.VarChar(64)
  accentColor              String?                @map("accent_color") @db.VarChar(16)
  heroStyle                String                 @default("soft") @map("hero_style") @db.VarChar(32)
  fontPair                 String                 @default("baloo") @map("font_pair") @db.VarChar(32)
  layout                   String                 @default("grid") @db.VarChar(32)
  productAutoRefresh       Boolean                @default(true) @map("product_auto_refresh")
  autoUpdatePrice          Boolean                @default(true) @map("auto_update_price")
  autoUpdateImage          Boolean                @default(true) @map("auto_update_image")
  autoReplaceDeadLink      Boolean                @default(false) @map("auto_replace_dead_link")
  autoSuggestBetterOffer   Boolean                @default(true) @map("auto_suggest_better_offer")
  autoSwitchBetterOffer    Boolean                @default(false) @map("auto_switch_better_offer")
  automaticOrderingAllowed Boolean                @default(false) @map("automatic_ordering_allowed")
  sourceListId             String?                @map("source_list_id") @db.Char(36)
  closedAt                 DateTime?              @map("closed_at") @db.DateTime(3)
  archivedAt               DateTime?              @map("archived_at") @db.DateTime(3)
  deletedAt                DateTime?              @map("deleted_at") @db.DateTime(3)
  createdAt                DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  owner                    User                   @relation("ListOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members                  ListMember[]
  invitations              ListInvitation[]
  gifts                    Gift[]
  reservations             Reservation[]
  contributions            Contribution[]
  clicks                   AffiliateClick[]
  wallet                   RewardWallet?
  payments                 Payment[]
  bankTransfers            BankTransfer[]
  fundsEntries             FundsLedgerEntry[]
  holdingBalances          HoldingBalance[]
  payouts                  Payout[]
  ledgerEntries            FinancialLedgerEntry[]
  orderGroups              OrderGroup[]
  notifications            Notification[]
  messages                 Message[]
  thankYous                ThankYou[]
  reports                  Report[]
  entitlement              ListEntitlement?
  secondHandOffers         SecondHandOffer[]
  memoryBook               MemoryBook?
  sourceList               GiftList?              @relation("FutureFamilyEvent", fields: [sourceListId], references: [id], onDelete: SetNull)
  futureLists              GiftList[]             @relation("FutureFamilyEvent")
  partnerAttribution       PartnerAttribution?
  lifecycleEvents          ListLifecycleEvent[]

  @@index([ownerId, status])
  @@index([visibility, status])
  @@index([dueDate])
  @@index([sourceListId, createdAt])
  @@map("lists")
}

model ListMember {
  id        String   @id @default(uuid()) @db.Char(36)
  listId    String   @map("list_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  role      ListRole
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  list      GiftList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId, role])
  @@map("list_members")
}

model ListInvitation {
  id           String    @id @default(uuid()) @db.Char(36)
  listId       String    @map("list_id") @db.Char(36)
  email        String    @db.VarChar(255)
  role         ListRole
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  invitedById  String    @map("invited_by_id") @db.Char(36)
  acceptedById String?   @map("accepted_by_id") @db.Char(36)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  acceptedAt   DateTime? @map("accepted_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  list         GiftList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  invitedBy    User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?     @relation("InvitationAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([listId, email])
  @@index([expiresAt])
  @@map("list_invitations")
}

model Merchant {
  id                    String                @id @default(uuid()) @db.Char(36)
  name                  String                @db.VarChar(180)
  slug                  String                @unique @db.VarChar(120)
  logoKey               String?               @map("logo_key") @db.VarChar(512)
  active                Boolean               @default(true)
  affiliationEnabled    Boolean               @default(false) @map("affiliation_enabled")
  affiliateNetwork      String?               @map("affiliate_network") @db.VarChar(120)
  affiliateIdentifier   String?               @map("affiliate_identifier") @db.VarChar(255)
  affiliateLinkTemplate String?               @map("affiliate_link_template") @db.VarChar(2048)
  affiliateRules        Json?                 @map("affiliate_rules")
  rewardEnabled         Boolean               @default(false) @map("reward_enabled")
  rewardShareRateBps    Int?                  @map("reward_share_rate_bps") @db.UnsignedSmallInt
  connectorType         String                @default("MANUAL") @map("connector_type") @db.VarChar(64)
  automationTrustLevel  Int                   @default(0) @map("automation_trust_level") @db.UnsignedTinyInt
  offerTrustScore       Int                   @default(50) @map("offer_trust_score") @db.UnsignedTinyInt
  refreshMinMinutes     Int                   @default(1440) @map("refresh_min_minutes") @db.UnsignedSmallInt
  connectorConfig       Json?                 @map("connector_config")
  createdAt             DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  domains               MerchantDomain[]
  gifts                 Gift[]
  images                ProductMedia[]
  mediaPolicy           MerchantMediaPolicy?
  offers                MerchantOffer[]
  snapshots             PriceSnapshot[]
  clicks                AffiliateClick[]
  commissions           AffiliateCommission[]
  orderGroups           OrderGroup[]

  @@index([active, affiliationEnabled])
  @@map("merchants")
}

model MerchantDomain {
  id         String   @id @default(uuid()) @db.Char(36)
  merchantId String   @map("merchant_id") @db.Char(36)
  domain     String   @unique @db.VarChar(253)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("merchant_domains")
}

model ProductIdentity {
  id          String          @id @default(uuid()) @db.Char(36)
  gtin        String?         @db.VarChar(32)
  ean         String?         @db.VarChar(32)
  mpn         String?         @db.VarChar(120)
  brand       String?         @db.VarChar(120)
  model       String?         @db.VarChar(180)
  identityKey String?         @unique @map("identity_key") @db.VarChar(255)
  matchStatus String          @default("CONTROLLED") @map("match_status") @db.VarChar(32)
  metadata    Json?
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  gifts       Gift[]
  offers      MerchantOffer[]

  @@index([gtin])
  @@index([ean])
  @@index([mpn])
  @@index([brand, model])
  @@map("product_identities")
}

model Gift {
  id                        String               @id @default(uuid()) @db.Char(36)
  listId                    String               @map("list_id") @db.Char(36)
  merchantId                String?              @map("merchant_id") @db.Char(36)
  productIdentityId         String?              @map("product_identity_id") @db.Char(36)
  publicToken               String               @unique @map("public_token") @db.Char(64)
  title                     String               @db.VarChar(240)
  description               String?              @db.Text
  kind                      GiftKind
  status                    GiftStatus           @default(AVAILABLE)
  url                       String?              @db.VarChar(2048)
  canonicalUrl              String?              @map("canonical_url") @db.VarChar(2048)
  sku                       String?              @db.VarChar(120)
  selectedVariant           Json?                @map("selected_variant")
  currency                  String               @default("EUR") @db.Char(3)
  unitPriceMinor            BigInt?              @map("unit_price_minor")
  priceAtCreationMinor      BigInt?              @map("price_at_creation_minor")
  quantity                  Int                  @default(1) @db.UnsignedSmallInt
  reservedQuantity          Int                  @default(0) @map("reserved_quantity") @db.UnsignedSmallInt
  fundedAmountMinor         BigInt               @default(0) @map("funded_amount_minor")
  contributionTargetMinor   BigInt?              @map("contribution_target_minor")
  secondHandPolicy          SecondHandPolicy     @default(NEW_ONLY) @map("second_hand_policy")
  offerPreference           OfferPreference      @default(FIXED_MERCHANT) @map("offer_preference")
  position                  Int                  @default(0)
  hiddenByModerator         Boolean              @default(false) @map("hidden_by_moderator")
  priceAlertsEnabled        Boolean              @default(false) @map("price_alerts_enabled")
  availabilityAlertsEnabled Boolean              @default(false) @map("availability_alerts_enabled")
  deadLinkAlertsEnabled     Boolean              @default(false) @map("dead_link_alerts_enabled")
  lastAvailability          String?              @map("last_availability") @db.VarChar(64)
  lastLinkHealthy           Boolean?             @map("last_link_healthy")
  refreshFailureCount       Int                  @default(0) @map("refresh_failure_count") @db.UnsignedSmallInt
  nextRefreshAt             DateTime?            @map("next_refresh_at") @db.DateTime(3)
  lastRefreshedAt           DateTime?            @map("last_refreshed_at") @db.DateTime(3)
  genericImageCategory      GenericImageCategory @default(OTHER) @map("generic_image_category")
  deletedAt                 DateTime?            @map("deleted_at") @db.DateTime(3)
  createdAt                 DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  list                      GiftList             @relation(fields: [listId], references: [id], onDelete: Cascade)
  merchant                  Merchant?            @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  productIdentity           ProductIdentity?     @relation(fields: [productIdentityId], references: [id], onDelete: SetNull)
  images                    ProductMedia[]
  offers                    MerchantOffer[]
  offerSwitches             GiftOfferSwitch[]
  snapshots                 PriceSnapshot[]
  reservations              Reservation[]
  contributions             Contribution[]
  clicks                    AffiliateClick[]
  orderItems                OrderGroupItem[]
  messages                  Message[]
  thankYous                 ThankYou[]
  secondHandOffers          SecondHandOffer[]

  @@index([listId, position])
  @@index([listId, status])
  @@index([merchantId, status])
  @@index([productIdentityId])
  @@index([nextRefreshAt, status])
  @@map("gifts")
}

model ProductMedia {
  id                    String                  @id @default(uuid()) @db.Char(36)
  giftId                String                  @map("gift_id") @db.Char(36)
  merchantId            String?                 @map("merchant_id") @db.Char(36)
  originalUrl           String?                 @map("source_url") @db.VarChar(2048)
  storedObjectKey       String?                 @map("storage_key") @db.VarChar(512)
  publicUrl             String?                 @map("public_url") @db.VarChar(2048)
  sourceType            ProductMediaSourceType  @map("source_type")
  usageStatus           ProductMediaUsageStatus @map("usage_policy")
  copyrightOwner        String?                 @map("copyright_owner") @db.VarChar(255)
  licenseName           String?                 @map("license_name") @db.VarChar(120)
  licenseUrl            String?                 @map("license_url") @db.VarChar(2048)
  termsUrl              String?                 @map("terms_url") @db.VarChar(2048)
  commercialUseAllowed  Boolean                 @default(false) @map("commercial_use_allowed")
  cacheAllowed          Boolean                 @default(false) @map("cache_allowed")
  remoteDisplayAllowed  Boolean                 @default(false) @map("remote_display_allowed")
  transformationAllowed Boolean                 @default(false) @map("transformation_allowed")
  redistributionAllowed Boolean                 @default(false) @map("redistribution_allowed")
  attributionRequired   Boolean                 @default(false) @map("attribution_required")
  attributionText       String?                 @map("attribution_text") @db.VarChar(500)
  verifiedAt            DateTime?               @map("verified_at") @db.DateTime(3)
  verifiedBy            String?                 @map("verified_by") @db.Char(36)
  reviewAfter           DateTime?               @map("review_after") @db.DateTime(3)
  etag                  String?                 @db.VarChar(255)
  lastModified          String?                 @map("last_modified") @db.VarChar(255)
  fetchedAt             DateTime?               @map("fetched_at") @db.DateTime(3)
  expiresAt             DateTime?               @map("expires_at") @db.DateTime(3)
  status                ImageStatus             @default(ACTIVE)
  position              Int                     @default(0)
  createdAt             DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  gift                  Gift                    @relation(fields: [giftId], references: [id], onDelete: Cascade)
  merchant              Merchant?               @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  claims                MediaClaim[]

  @@index([giftId, position])
  @@index([usageStatus, status])
  @@index([expiresAt])
  @@map("gift_images")
}

model MerchantMediaPolicy {
  id                  String    @id @default(uuid()) @db.Char(36)
  merchantId          String    @unique @map("merchant_id") @db.Char(36)
  allowMetadata       Boolean   @default(true) @map("allow_metadata")
  allowRemoteDisplay  Boolean   @default(false) @map("allow_remote_display")
  allowCaching        Boolean   @default(false) @map("allow_caching")
  allowLocalStorage   Boolean   @default(false) @map("allow_local_storage")
  allowTransformation Boolean   @default(false) @map("allow_transformation")
  allowCommercialUse  Boolean   @default(false) @map("allow_commercial_use")
  attributionRequired Boolean   @default(false) @map("attribution_required")
  attributionTemplate String?   @map("attribution_template") @db.VarChar(500)
  licenseSourceUrl    String?   @map("license_source_url") @db.VarChar(2048)
  termsSourceUrl      String?   @map("terms_source_url") @db.VarChar(2048)
  verifiedAt          DateTime? @map("verified_at") @db.DateTime(3)
  verifiedBy          String?   @map("verified_by") @db.Char(36)
  reviewAfter         DateTime? @map("review_after") @db.DateTime(3)
  status              String    @default("REVIEW_REQUIRED") @db.VarChar(32)

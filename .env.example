# Copy this file to .env and replace every required A_REMPLIR value locally.
# Never commit the resulting .env file.

# Application
APP_ENV=development
NODE_ENV=development
APP_NAME=Mila
APP_URL=http://localhost
PUBLIC_APP_URL=http://localhost
API_PUBLIC_URL=/api/v1
ASSET_PUBLIC_URL=/assets
APP_DOMAIN=localhost
WEBHOOK_BASE_URL=http://localhost/api/v1/webhooks
TRUST_PROXY=false
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# SEO
SEO_INDEXING_ENABLED=false

# Database — remote MySQL is the official target
DATABASE_HOST=A_REMPLIR
DATABASE_PORT=3306
DATABASE_NAME=mila
DATABASE_USER=A_REMPLIR
DATABASE_PASSWORD=A_REMPLIR
DATABASE_URL=A_REMPLIR
DATABASE_SSL_MODE=preferred
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# Redis and queues
REDIS_URL=A_REMPLIR
QUEUE_PREFIX=mila

# Authentication and cookies
AUTH_SECRET=A_REMPLIR
SESSION_SECRET=A_REMPLIR
SESSION_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
COOKIE_NAME=mila_session
VITE_AUTH_COOKIE_NAME=mila_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
FEATURE_OAUTH=false
CORS_ALLOWED_ORIGINS=http://localhost

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=Mila <A_REMPLIR>
SMTP_HOST=A_REMPLIR
SMTP_PORT=587
SMTP_USER=A_REMPLIR
SMTP_PASSWORD=A_REMPLIR
SMTP_SECURE=false
RESEND_API_KEY=A_REMPLIR

# S3-compatible object storage / MinIO
STORAGE_ENDPOINT=A_REMPLIR
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=A_REMPLIR
STORAGE_SECRET_KEY=A_REMPLIR
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_PRODUCT_IMAGES=product-images
STORAGE_BUCKET_LIST_COVERS=list-covers
STORAGE_BUCKET_USER_UPLOADS=user-uploads
STORAGE_BUCKET_MEDIA_MESSAGES=media-messages
STORAGE_BUCKET_EXPORTS=exports
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Mollie — disabled until credentials, contract and legal model are validated
FEATURE_MOLLIE_PAYMENTS=false
FEATURE_MOLLIE_CONNECT=false
FEATURE_CONTRIBUTIONS=false
FEATURE_PARENT_PAYOUTS=false
MOLLIE_MODE=test
MOLLIE_API_KEY=A_REMPLIR
MOLLIE_CLIENT_ID=A_REMPLIR
MOLLIE_CLIENT_SECRET=A_REMPLIR
MOLLIE_WEBHOOK_URL=
MOLLIE_REDIRECT_URL=

# Affiliate integrations
FEATURE_AFFILIATION=false
AFFILIATE_WEBHOOK_SECRET=A_REMPLIR
AFFILIATE_NETWORK_API_KEY=A_REMPLIR

# Product extraction
PRODUCT_FETCH_USER_AGENT=MilaBot/1.0
PRODUCT_FETCH_TIMEOUT_MS=8000
PRODUCT_FETCH_MAX_BYTES=524288
PRODUCT_FETCH_MAX_REDIRECTS=3

# Feature flags
FEATURE_REWARDS=false
FEATURE_AFFILIATE_REWARDS=false
FEATURE_REFERRAL_REWARDS=false
FEATURE_PARTNER_REWARDS=false
FEATURE_PREMIUM_REWARDS=false
FEATURE_REWARD_REDEMPTION=false
FEATURE_BANK_PAYOUT=false
FEATURE_REWARD_MARKETPLACE=false
FEATURE_SECOND_HAND=false
FEATURE_PRICE_TRACKING=false
FEATURE_PRICE_ALERTS=false
FEATURE_PRICE_COMPARISON=false
FEATURE_MEDIA_MESSAGES=false
FEATURE_AUDIO_MESSAGES=false
FEATURE_VIDEO_MESSAGES=false
FEATURE_MEMORY_BOOK=false
FEATURE_THANK_YOU_TRACKER=false
FEATURE_PREMIUM=false
FEATURE_PARTNERS=false
FEATURE_FAMILY_EVENTS=false
FEATURE_PWA_PUSH=false
FEATURE_AUTOMATIC_ORDERS=false

# Analytics and observability
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=none
ANALYTICS_WRITE_KEY=A_REMPLIR
SENTRY_DSN=A_REMPLIR

# Worker controls
WORKER_CONCURRENCY=5
WORKER_PRODUCT_REFRESH_ENABLED=true
WORKER_EMAIL_ENABLED=true
WORKER_PAYMENTS_ENABLED=false
WORKER_REWARDS_ENABLED=false

FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install --global npm@11.6.2
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
RUN npm ci
COPY . .
ARG VITE_PUBLIC_APP_URL=
ARG VITE_SEO_INDEXING_ENABLED=false
ARG VITE_FEATURE_REWARDS_PREMIUM=false
ARG VITE_FEATURE_ORDER_FULFILMENT=false
ARG VITE_FEATURE_SECOND_HAND_OFFERS=false
ARG VITE_FEATURE_MEDIA_MESSAGES=false
ARG VITE_FEATURE_THANK_YOUS=false
ARG VITE_FEATURE_MEMORY_BOOK=false
ENV VITE_PUBLIC_APP_URL=$VITE_PUBLIC_APP_URL
ENV VITE_SEO_INDEXING_ENABLED=$VITE_SEO_INDEXING_ENABLED
ENV VITE_FEATURE_REWARDS_PREMIUM=$VITE_FEATURE_REWARDS_PREMIUM
ENV VITE_FEATURE_ORDER_FULFILMENT=$VITE_FEATURE_ORDER_FULFILMENT
ENV VITE_FEATURE_SECOND_HAND_OFFERS=$VITE_FEATURE_SECOND_HAND_OFFERS
ENV VITE_FEATURE_MEDIA_MESSAGES=$VITE_FEATURE_MEDIA_MESSAGES
ENV VITE_FEATURE_THANK_YOUS=$VITE_FEATURE_THANK_YOUS
ENV VITE_FEATURE_MEMORY_BOOK=$VITE_FEATURE_MEMORY_BOOK
RUN npm run build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
WORKDIR /app
COPY --from=build /app/dist ./dist
EXPOSE 3000
USER node
CMD ["node", "dist/server/index.mjs"]
